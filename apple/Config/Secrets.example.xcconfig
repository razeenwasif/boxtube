// Copy this file to Secrets.xcconfig (same folder) and fill in your key.
// Secrets.xcconfig is git-ignored.
//
// YouTube Data API v3 key: console.cloud.google.com > APIs & Services > Credentials > Create credentials > API key.
// Enable "YouTube Data API v3" for the project, and restrict the key to the iOS bundle id com.razeenwasif.boxtube.
YOUTUBE_API_KEY = paste-your-key-here

// Google sign-in (optional): APIs & Services > Credentials > Create credentials > OAuth client ID > Desktop app.
// Add your Google account as a test user on the OAuth consent screen. Desktop secrets aren't confidential,
// but keep them out of git anyway.
GOOGLE_CLIENT_ID = paste-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = paste-client-secret
